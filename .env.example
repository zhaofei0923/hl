# ==========================================
# 婚恋中介管理平台 环境变量配置
# ==========================================

# Node
NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=root123456
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hl_matchmaking
DB_USER=hl_user
DB_PASSWORD=hl123456

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=hl-matchmaking-jwt-secret-key-2026
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=hl-matchmaking-refresh-secret-key-2026
JWT_REFRESH_EXPIRES_IN=7d

# SMS (阿里云短信)
SMS_ACCESS_KEY=your_access_key
SMS_SECRET_KEY=your_secret_key
SMS_SIGN_NAME=婚恋平台
SMS_TEMPLATE_CODE=SMS_000000

# WeChat OAuth
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Server
SERVER_PORT=3000
CLIENT_URL=http://localhost:5173,http://localhost:5174
