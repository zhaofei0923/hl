# ==========================================
# 婚恋中介管理平台 - 生产环境配置
# 复制此文件为 .env.prod 并填入实际值
# ==========================================

# Node
NODE_ENV=production

# MySQL
MYSQL_ROOT_PASSWORD=<替换为强密码>
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hl_matchmaking
DB_USER=hl_user
DB_PASSWORD=<替换为强密码>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (务必更换为随机长字符串)
JWT_SECRET=<替换为随机密钥-至少32位>
JWT_REFRESH_SECRET=<替换为另一个随机密钥-至少32位>
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS 白名单 (生产域名，多个用逗号分隔)
CLIENT_URL=https://hl.easudata.com

# SSL 证书目录 (docker-compose 挂载到 nginx 容器)
SSL_CERT_DIR=/opt/hl/ssl

# SMS
SMS_ACCESS_KEY=your_access_key
SMS_SECRET_KEY=your_secret_key
SMS_SIGN_NAME=婚恋平台
SMS_TEMPLATE_CODE=SMS_000000

# WeChat OAuth
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Server
SERVER_PORT=3000

# 前端端口映射 (可改为其他端口避免与宿主机其他项目冲突)
CLIENT_PORT=80
